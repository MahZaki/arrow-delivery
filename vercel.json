{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/zr/(.*)", "destination": "https://api.zrexpress.app/api/v1.0/$1" },
    { "source": "/api/wa/send-message", "destination": "https://www.wasenderapi.com/api/send-message" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
